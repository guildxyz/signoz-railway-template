{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "signoz/Dockerfile.otel"
  },
  "deploy": {
    "startCommand": "/bin/sh -c '/signoz-otel-collector migrate sync check --dsn=tcp://clickhouse.railway.internal:9000 && /signoz-otel-collector --config=/etc/otel-collector-config.yaml --manager-config=/etc/manager-config.yaml --copy-path=/var/tmp/collector-config.yaml'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
